 "devices": {
  "Ag": {
   "title": "Yamaha AG06",
   "badge": "주의 1",
   "bg": "#fff3d6",
   "l1": "+48V(팬텀)가 켜져 있어요. CH1 DI BOX가 패시브면 끄는 것이 안전해요.",
   "l2": "키보드는 TRS 출력을 TS 2줄로 나눠 3/4에, 드럼은 TS 모노 2줄→RCA로 5/6에 연결해요.",
   "l3": "STEREO OUT → DFX-12 9/10 L·R",
   "go": "AG06 상세 보기"
  },
  "L4": {
   "title": "MiCWL L4",
   "badge": "정상",
   "bg": "#dff5e3",
   "l1": "CD → CH1/2 (RCA↔RCA + TS 어댑터), PC → CH3/4 (AUX→RCA).",
   "l2": "MAIN OUT L·R → DFX-12 CD/TAPE IN (스테레오).",
   "l3": "막힌 곳이 없어요.",
   "go": "L4 상세 보기"
  },
  "Dfx": {
   "title": "Mackie DFX-12",
   "badge": "참고 1",
   "bg": "#d8ecff",
   "l1": "11/12번만 비어 있어요(안 쓰는 채널은 페이더를 맨 아래로). 5/6번은 매립형 라인이 이어져 있어요.",
   "l2": "1·2번 강대상1 구즈넥 L·R, 3·4·5/6번 매립형 XLR(기도석·아래강대상), 7/8번 무선, 9/10번 AG06, CD/TAPE IN은 L4.",
   "l3": "MAIN OUT L·R(XLR) → QSC, PHONES → MPS1200.",
   "go": "DFX-12 상세 보기"
  },
  "Qsc": {
   "title": "R 스피커가 약해요",
   "badge": "주의 · 이슈 #1",
   "bg": "#fff3d6",
   "l1": "1) L·R 스피커 케이블을 바꿔 꽂아 보세요.",
   "l2": "2) R 스피커만 따로 테스트 음원으로 확인하세요.",
   "l3": "3) QSC R 채널 게인 노브 위치와 DFX-12 MAIN R 페이더를 확인하세요.",
   "go": "DFX-12 MAIN 보기"
  },
  "Mps": {
   "title": "MPS1200 CH1 고장",
   "badge": "오류",
   "bg": "#ffd9d6",
   "l1": "MPS1200은 자모실 스피커용 서브 앰프예요. CH1 채널이 고장났어요.",
   "l2": "자모실 스피커가 CH1에 연결돼 있는지 확인이 필요해요. 모니터 스피커는 메인 스피커에서 이어지는 구성이라 MPS1200과 무관해요.",
   "l3": "DFX-12 PHONES → MPS1200 입력은 그대로 연결돼 있어요.",
   "go": "배선 편집"
